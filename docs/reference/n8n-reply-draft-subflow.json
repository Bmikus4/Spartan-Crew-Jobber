        "jsCode": "return {\n  signature_html: `<table width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"font-family:Arial,Helvetica,sans-serif;width:600px;color:#1d1d1b\">\n  <tbody>\n    <tr>\n      <td width=\"200\" style=\"padding:0;vertical-align:top\">\n        <a href=\"https://spartancrew.co.uk/\" target=\"_blank\" style=\"border:none;text-decoration:none\">\n          <img src=\"https://designexpert44.com/signature/july23/spartan_crew/logo.png\" width=\"180\" height=\"44\" alt=\"Spartan Crew\" style=\"display:block;border:0\">\n        </a>\n      </td>\n\n      <td width=\"400\" style=\"padding-left:15px;border-left:2px solid #c72017;vertical-align:top\">\n        <p style=\"margin:0 0 4px 0;font-size:16px;line-height:1.2;color:#222\"><strong>Spartan Crew</strong></p>\n        <p style=\"margin:0 0 4px 0;font-size:16px;line-height:1.2;color:#c72017\"><strong>Bookings</strong></p>\n        <p style=\"margin:0 0 8px 0;font-size:12px;line-height:1.2\"><strong>Spartan Crew Ltd.</strong></p>\n\n        <p style=\"margin:0 0 4px 0;font-size:12px;line-height:1.4\">\n          <img src=\"https://designexpert44.com/signature/july23/spartan_crew/telephone.png\" width=\"13\" height=\"11\" alt=\"\" style=\"border:0;vertical-align:middle\"> &nbsp;\n          <a href=\"tel:03333053374\" style=\"color:#1d1d1b;text-decoration:none\">03333 053374</a>\n        </p>\n\n        <p style=\"margin:0 0 4px 0;font-size:12px;line-height:1.4\">\n          <img src=\"https://designexpert44.com/signature/july23/spartan_crew/website.png\" width=\"13\" height=\"13\" alt=\"\" style=\"border:0;vertical-align:middle\"> &nbsp;\n          <a href=\"https://spartancrew.co.uk/\" style=\"color:#1d1d1b;text-decoration:none\">www.spartancrew.co.uk</a>\n        </p>\n\n        <p style=\"margin:0 0 8px 0;font-size:12px;line-height:1.4\">\n          <img src=\"https://designexpert44.com/signature/july23/spartan_crew/place.png\" width=\"13\" height=\"13\" alt=\"\" style=\"borde