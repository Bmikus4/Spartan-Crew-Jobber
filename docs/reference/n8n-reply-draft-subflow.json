    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst replyTo = data.original_email.from;\nconst subject = data.subject;\nconst threadId = data.original_email.thread_id;\nconst messageId = data['message-ID'];\nconst body = data.body;\nconst signature = data.signature_html;\nconst yourEmail = \"bookings@spartancrew.co.uk\";\n\n// Parse CC from input\nlet ccAddresses = [];\ntry {\n  const raw = data.Cc;\n  // If it's already an array, use it directly; otherwise try to parse\n  if (Array.isArray(raw)) {\n    ccAddresses = raw;\n  } else if (typeof raw === 'string' && raw.trim() !== '') {\n    const parsed = JSON.parse(raw);\n    ccAddresses = Array.isArray(parsed) ? parsed : [parsed];\n  }\n} catch (e) {\n  if (data.Cc && typeof data.Cc === 'string') {\n    ccAddresses = data.Cc.split(',').map(e => e.trim());\n  }\n}\n\n// Clean CC: remove nulls, blanks, yourself, and the main recipient\nconst cleanCc = [...new Set(\n  ccAddresses\n    .filter(e => typeof e === 'string' && e.trim() !== '')   // ← THIS is the key fix\n    .map(e => e.trim().toLowerCase())\n    .filter(e => !e.includes(yourEmail.toLowerCase()))\n    .filter(e => !e.includes(replyTo.toLowerCase()))\n)];\n\nconst ccLine = cleanCc.join(', ');\n\n// Build HTML body with signature\nconst htmlBody = `<html><body>${body}<br>${signature}</body></html>`;\n\n// Build raw RFC 2822 message\nconst messageLines = [\n  `From: ${yourEmail}`,\n  `To: ${replyTo}`,\n];\n\nif (ccLine) {\n  messageLines.push(`Cc: ${ccLine}`);\n}\n\nmessageLines.push(\n  `Subject: ${subject}`,\n  `In-Reply-To: ${messageId}`,\n  `References: ${messageId}`,\n  `MIME-Version: 1.0`,\n  `Content-Type: text/html; charset=\"UTF-8\"`,\n  ``,\n  htmlBody\n);\n\nconst rawMessage = messageLines.join('\\r\\n');\n\n// Base64url encode\nconst encoded = Buffer.from(rawMessage)\n  .toString('base64')\n  .replace(/\\+/g, '-')\n  .replace(/\\//g, '_')\n  .replace(/=+$/, '');\n\nreturn [{\n  json: {\n    raw: encoded,\n    threadId: threadId\n  }\n}];"
      },
