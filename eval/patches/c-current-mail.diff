+// ============================================================================
+// A new order is booked at the venue this client books, not a new or unused place of a similar name.
+// ----------------------------------------------------------------------------
+// eval/phase-c.md C1: on current mail, creates booked a new place, or a place no booking has ever used,
+// where staff used the client's own venue, booked 2 to 32 times. Its name words and the email's share two
+// or more, one set holding the other: 2 of 2 (1a15984719fbd60e), 4 of 4 (1a13438a3dd67400), and 3 of 3
+// against an unused exact-name duplicate (1a15984f57ab3251). The names here are invented; the shapes are
+// the cases'.
+// npx tsx test/planVenueClientHistory.ts
+// ============================================================================
+import { plan, type World, type Message } from "../app/lib/v2/interpret/plan";
+import type { Interpretation, Request } from "../app/lib/v2/interpret/interpret";
+import { coded } from "../app/lib/v2/reasons";
+
+let fails = 0;
+const ok = (c: boolean, m: string, d?: unknown) => { console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : "  " + JSON.stringify(d)}`); if (!c) fails++; };
+
+const PLACES = [
+  { id: 1114, name: "Harbour Hall", address: "1 Quay Road" },
+  { id: 205, name: "Riverside Studios Hammersmith", address: "101 Queen Caroline Street" },
+  { id: 7083, name: "Riverside Studios", address: "101 Queen Caroline St" },          // a duplicate no booking uses
+  { id: 300, name: "Kings Place", address: "90 York Way" },
+  { id: 301, name: "Kings Place Hall Two", address: "90 York Way" },
+  { id: 640, name: "Old Exchange Rooms", address: "4 Market Street" },             // OnSinch holds it; this client never booked it
+];
+const at = (place: number) => ({ id: place * 10, beginning: "2026-09-01T08:00:00+01:00", end: "2026-09-01T16:00:00+01:00", size: 2, profession_id: 1, role: 0, SlotLocation: { place_id: place } });
+const past = (n: number, place: number) => ({ id: 9000 + n, number: String(9000 + n), company_id: 157, created: `2026-09-0${n}T10:00:00Z`, Job: [{ SlotTeam: [{ id: 800 + n, Slot: [at(place)] }] }] });
+const history = [past(1, 1114), past(2, 205), past(3, 300), past(4, 301)];
+const world: World = {
+  companies: async () => [{ id: 157, name: "Client", Client: [{ id: 1, email: "ops@client.example" }] }],
+  placesNamed: async (n) => PLACES.filter((p) => p.name.toLowerCase() === n.toLowerCase()),
+  allPlaces: async () => PLACES,
+  companyOrders: async (c) => (c === 157 ? history : []),
+  orderByNumber: async () => null,
+} as World;
+const msg: Message = { message_id: "m1", from: "ops@client.example", subject: "crew", sentIso: "2026-10-20T09:00:00Z", text: "(the email)" };
+const r = (venue: string): Request => ({ action: "new_shift", problems: [], date: "2026-11-20", start: "08:00", end: "16:00", crew: 3, venue } as Request);
+const I = (requests: Request[]): Interpretation => ({ intent: "booking", requests, problems: [] });
+const placeOf = (d: any) => d.kind === "write" ? d.ops.find((o: any) => o.op.kind === "create_order")?.op.shifts[0].place_id : `(${d.kind}: ${(d.reasons ?? [d.reason]).join("; ")})`;
+
+(async () => {
+  console.log("\nthe email names the client's venue in more words");
+  const more = await plan(msg, I([r("The Harbour Hall Hotel")]), world);
+  ok(placeOf(more) === "1114", "\"The Harbour Hall Hotel\" is the client's Harbour Hall (1114), not a new place", placeOf(more));
+  ok(more.kind === "write" && more.why.some((w: string) => /the one OnSinch venue whose name fits these words/.test(w)), "and the order says it assumed so", more);
+  ok(more.kind === "write" && (coded(more as any) as any).defaults?.includes("default_venue_assumed"), "coded default_venue_assumed", coded(more as any));
+
+  console.log("\nthe email names it in fewer words, and an unused duplicate has that exact name");
+  const fewer = await plan(msg, I([r("Riverside Studios")]), world);
+  ok(placeOf(fewer) === "205", "the client's Riverside Studios Hammersmith (205), not the unused exact-name 7083", placeOf(fewer));
+
+  console.log("\nno place has the name; exactly one OnSinch place fits the words");
+  const other = await plan(msg, I([r("The Old Exchange Rooms Gallery")]), world);
+  ok(placeOf(other) === "640", "the Old Exchange Rooms (640), not a new place", placeOf(other));
+
+  console.log("\nunchanged");
+  const fresh = await plan(msg, I([r("Lakeside Pavilion")]), world);
+  ok(String(placeOf(fresh)).startsWith("new:"), "a venue the client has never booked and OnSinch does not hold is still a new place", placeOf(fresh));
+  const two = await plan(msg, I([r("Kings Place Hall")]), world);
+  ok(placeOf(two) !== "300" && placeOf(two) !== "301", "two client venues fit (Kings Place, Kings Place Hall Two): no guess between them", placeOf(two));
+
+  if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+  console.log("\nall passed");
+})();
