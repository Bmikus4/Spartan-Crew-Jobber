+// ============================================================================
+// A reply card whose email asks for crew is listed, and our reply alone does not clear it.
+// ----------------------------------------------------------------------------
+// 8 of the live week's 16 silent misses (10-14..10-21, two blind readers, eval/live-week-reads.md)
+// were reply hand-offs on emails asking for crew: "book 2 crew, times TBC". The TV lists only
+// needs-created and needs-updated cards, and our reply cleared the item, so the booking was on
+// no screen. A plain question (a quote with no shifts, a rate) still leaves when we answer it.
+// npx tsx test/feedReplyWithWork.ts
+// ============================================================================
+import { project } from "../app/lib/feed/project";
+import { v2Sources, type V2Row } from "../app/lib/feed/v2";
+
+let fails = 0;
+const ok = (c: boolean, m: string, d?: unknown) => { console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : "  " + JSON.stringify(d)}`); if (!c) fails++; };
+
+const NOW = Date.parse("2026-10-03T12:00:00Z");
+const H = 3_600_000;
+const row = (thread: string, over: Partial<V2Row>): V2Row => ({
+  thread_id: thread, message_id: `${thread}-m`, sent_at: new Date(NOW - 3 * H).toISOString(), kind: "handoff",
+  grounded: { intent: "booking", requests: [], problems: [] }, decision: { kind: "handoff", reasons: ["x"] },
+  executed: null, company_id: 343, company: "Client", from_address: "sam@client.example", subject: "Crew", ...over,
+});
+// A booking with no times: the planner asks the client, so the card is a reply card.
+const work = row("W", { grounded: { intent: "booking", requests: [{ action: "new_shift", date: "2026-10-14", crew: 2, problems: [] }], problems: [] }, decision: { kind: "handoff", reasons: ["request 1: no start time the client wrote"] } });
+const plain = row("Q", { grounded: { intent: "quote_request", requests: [], problems: [] }, decision: { kind: "handoff", reasons: ["the client asked for a quote"] } });
+// The reader could not tell what it asks: §4 says show it.
+const unclear = row("U", { grounded: { intent: "unclear", requests: [], problems: [] }, decision: { kind: "handoff", reasons: ["the request is unclear"] } });
+const cards = (out = new Map<string, number>()) => project([], new Map(), [], null, NOW, out, v2Sources([work, plain, unclear], NOW)).cards;
+const listed = (c: { items: Array<{ kind: string; work?: boolean }> }) => c.items.some((i) => i.kind === "needs-created" || i.kind === "needs-updated" || (i.kind === "needs-reply" && !!i.work));
+
+console.log("\nbefore we reply");
+{
+  const cs = cards();
+  const w = cs.find((c) => c.thread_id === "W"), q = cs.find((c) => c.thread_id === "Q");
+  ok(!!w && w.items[0].kind === "needs-reply" && !!w.items[0].work, "the crew request is a reply card marked as work", w?.items);
+  ok(!!w && listed(w), "and it is listed", w?.items);
+  ok(!!q && !q.items[0].work && !listed(q), "a plain quote question is not listed", q?.items);
+  const u = cs.find((c) => c.thread_id === "U");
+  ok(!!u && listed(u), "an email the reader found unclear is listed: uncertain is shown (§4)", u?.items);
+}
+
+console.log("\nafter our reply");
+{
+  const cs = cards(new Map([["W", NOW - H], ["Q", NOW - H]]));
+  ok(!!cs.find((c) => c.thread_id === "W"), "the crew request stays: answering its question does not book it");
+  ok(!cs.find((c) => c.thread_id === "Q"), "the quote question leaves, as before");
+}
+
+if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+console.log("\nall passed");
