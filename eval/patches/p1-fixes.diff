diff --git a/app/lib/v2/acceptance.ts b/app/lib/v2/acceptance.ts
new file mode 100644
index 0000000..749ba41
--- /dev/null
+++ b/app/lib/v2/acceptance.ts
@@ -0,0 +1,54 @@
+// ============================================================================
+// A client accepting Spartan's quote is work, even though nothing new is asked for.
+// ----------------------------------------------------------------------------
+// eval/acceptance-study.md (10-25, 799 client emails read by two blind readers): 73 emails
+// accept a quote or offer Spartan sent. The system decided `none` for 49 of them: "no change
+// asked for" (the reader saw no request), "already booked" or "already as asked" (the quote is
+// already an order: for 54 of the 73, OnSinch held one for that day before the acceptance). Staff
+// then completed and confirmed that order by hand: team description, contacts, slot status.
+// Decided `none`, the acceptance reached no screen.
+//
+// The rule is the study's, measured on those 799 emails: it fires on 88, both readers call 70 of
+// them booking work, it catches 68 of the 73, and both readers call 1 of the 88 "nothing". It
+// was tuned on those same emails, so expect less on new mail. It never builds shifts: Spartan's
+// quotes carry them in an attached PDF the system does not read (0 of 73 fully readable). It
+// only turns the `none` into a card for a person to confirm the order.
+// ============================================================================
+import { latestText, norm } from "./interpret/ground";
+import type { ThreadMsg } from "./threadState";
+
+/** Spartan's own terms: a quote is valid 14 days. */
+const VALID_MS = 14 * 24 * 3_600_000;
+/** Spartan's signature blocks, cut so that their boilerplate never reads as a quote. */
+const own = (body: string) => latestText(body).split(/\*{3} We now|\*Please note, all quotes/)[0];
+
+const QUOTE_WORD = /\bquot(e|es|ed|ation)\b|\bpro ?forma\b/i;
+const ASKS = /\b(chas(e|ing)|follow(ing)? up|provisional(ly)?|pencil(led)?|any (word|update)|ready to (confirm|move ahead|go ahead)|(moving|move|go(ing)?) ahead|confirm|proceed)\b|\b(see|find)\b.{0,30}\battached\b/i;
+
+const ACCEPT = new RegExp([
+  /\bgo(ing)? ahead\b/, /\bproceed\b/,
+  /\b(can|could|may|shall) (we|i) (please )?confirm\b/, /\bplease (could i |can we )?confirm (this|it|the (booking|order|job|crew|shifts?))\b/,
+  /\b(happy|good|ok|okay|fine) to confirm\b/,
+  /\b(this|that|it|order|job|jobs|booking|one|all|everything)('s| is| are| has been| have been)? (all |now )?confirmed\b/, /^(yes,? )?(all )?confirmed\b/,
+  /\b(like|want|wish) to (confirm|book)\b/, /\bbook (this|it|that|them|these|the crew)( one)?\b/, /\bplease book\b/, /\bmay this be booked\b/,
+  /\block (it |this |that |the \w+ )?in\b/, /\b(looks|sounds) good\b/, /\b(as|for) confirmation\b/,
+  /\bp\.?o\.?( number| no\.?)?\s*(is|:|-|#)?\s*[a-z_\-]*\d{3,}/, /\b(attached|find|see) (the |our )?(p\.?o|purchase order)\b/, /\bpurchase order\b/,
+  /\b(send|get|raise|sort)( over| you| out)? (a |the |our )?(p\.?o|purchase order)\b/, /\bp\.?o\.? (to follow|will follow)\b/,
+].map((r) => r.source).join("|"), "i");
+const NOT = /\b(cancel(led|ling)?|no longer|not (be )?(go(ing)?|proceed(ing)?) ahead|won'?t (be )?(go(ing)?|proceed(ing)?) ahead|won'?t be (needed|required)|stand down|decline|still (go(ing)? ahead|on|happening))\b|\bconfirm (if|whether|availability|that you|you)\b|\b(can|could) you (please )?confirm\b/i;
+
+/** Did Spartan's latest message before this email, within 14 days, quote or ask to confirm? */
+function spartanQuoted(sentMs: number, subject: string, fullBody: string, thread: ThreadMsg[]): boolean {
+  const last = thread.filter((x) => x.ours && x.at < sentMs).sort((a, b) => a.at - b.at).at(-1);
+  if (last && sentMs - last.at <= VALID_MS && (QUOTE_WORD.test(own(last.body)) || ASKS.test(own(last.body)))) return true;
+  // OnSinch sends the quote itself; its notice survives only in the client's quoted history.
+  return /^(re|fw|fwd)\s*:\s*price quote - r\d+/i.test(norm(subject)) && /new order approved[\s\S]{0,300}quote attached/i.test(norm(fullBody));
+}
+
+/** The client's newest words accept Spartan's quote or offer. */
+export function acceptsQuote(e: { newest: string; subject: string; fullBody: string; sentIso: string }, thread: ThreadMsg[]): boolean {
+  const head = norm(e.newest.replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ")).slice(0, 600);
+  return ACCEPT.test(head) && !NOT.test(head) && spartanQuoted(Date.parse(e.sentIso), e.subject, e.fullBody, thread);
+}
+
+export const QUOTE_ACCEPTED = "the client accepted Spartan's quote: confirm the order in OnSinch";
