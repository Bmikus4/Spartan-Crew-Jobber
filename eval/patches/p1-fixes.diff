+// ============================================================================
+// A client accepting Spartan's quote becomes a card to confirm the order, never `none`.
+// ----------------------------------------------------------------------------
+// eval/acceptance-study.md (10-25): 73 of 799 client emails accept a quote or offer Spartan
+// sent, and 49 of them were decided `none` ("no change asked for", "already booked", "already as
+// asked"), so they reached no screen while staff confirmed the order by hand.
+// Offline, on PGlite (fixtures/pg.ts) for the decideMessage half.  npx tsx test/v2QuoteAccepted.ts
+// ============================================================================
+import "./fixtures/pg";
+import { acceptsQuote, QUOTE_ACCEPTED } from "../app/lib/v2/acceptance";
+import type { ThreadMsg } from "../app/lib/v2/threadState";
+/* eslint-disable @typescript-eslint/no-require-imports */
+process.env.VERCEL_GIT_COMMIT_SHA = "test";
+const { decideMessage } = require("../app/lib/v2/process.ts");
+
+let fails = 0;
+const ok = (c: boolean, m: string, d?: unknown) => { console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : "  " + JSON.stringify(d)}`); if (!c) fails++; };
+
+const SENT = "2026-11-02T09:00:00Z";
+const ours = (daysBefore: number, body: string): ThreadMsg => ({ message_id: `o${daysBefore}`, from: "bookings@spartancrew.co.uk", to: ["sam@client.example"], at: Date.parse(SENT) - daysBefore * 864e5, subject: "Crew", body, ours: true });
+const quoted = [ours(2, "Hi Sam, please find attached our quote for the install. Let us know if you would like to go ahead.")];
+const e = (newest: string) => ({ newest, subject: "Re: Crew", fullBody: newest, sentIso: SENT });
+
+console.log("the rule");
+ok(acceptsQuote(e("Thanks, happy to go ahead. PO number is 45512."), quoted), "go ahead with a PO, after our quote, accepts it");
+ok(acceptsQuote(e("Great, please book it in."), quoted), "please book it in accepts it");
+ok(!acceptsQuote(e("Could you confirm availability for Friday?"), quoted), "asking us to confirm availability is not an acceptance");
+ok(!acceptsQuote(e("We will no longer be going ahead, sorry."), quoted), "withdrawing is not an acceptance");
+ok(!acceptsQuote(e("Happy to go ahead."), []), "with no message of ours in the thread, there is no quote to accept");
+ok(!acceptsQuote(e("Happy to go ahead."), [ours(20, "please find attached our quote")]), "a quote older than 14 days has lapsed");
+
+(async () => {
+  console.log("\nthrough decideMessage: the reader saw no change, and the email accepts our quote");
+  const m = { message_id: "q1", thread_id: "tq", from_address: "sam@client.example", date_iso: SENT, subject: "Re: Crew", body: "Thanks, happy to go ahead. PO number is 45512.", is_from_spartan: false };
+  const world = {
+    companies: async () => [{ id: 137, name: "Client Ltd", Client: [{ id: 1, email: "sam@client.example" }] }],
+    placesNamed: async () => [], companyOrders: async () => [], orderByNumber: async () => null, orderById: async () => null,
+  };
+  const deps = (thread: ThreadMsg[]) => ({
+    extract: async () => ({ x: { intent: "info_only", po: null, note: "", requests: [] }, meta: { model: "recorded", prompt_id: "t", input_tokens: 0, output_tokens: 0, cost_usd: 0, ms: 0 } }),
+    world, threadOrderId: async () => null, run: null, record: async () => {}, trace: () => {}, threadMessages: async () => thread,
+  });
+  const after = await decideMessage(m, deps(quoted));
+  ok(after.decision.kind === "handoff" && after.decision.reasons[0] === QUOTE_ACCEPTED, "it is a card to confirm the order", after.decision);
+  const plain = await decideMessage(m, deps([]));
+  ok(plain.decision.kind === "none", "the same words with no quote of ours stay `none` (control)", plain.decision);
+
+  if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+  console.log("\nall passed");
+})().catch((err) => { console.error(err); process.exit(1); });
