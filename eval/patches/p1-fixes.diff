+// ============================================================================
+// A sender whose domain several clients share is placed by the company the email names.
+// ----------------------------------------------------------------------------
+// OPERATING §9.3: one sender for several clients is settled by content, never by the most
+// frequent. matchCompanyByDomain abstains when a domain sits on more than one company, and 3 of
+// the live week's 7 emails with no client were on such a domain: each went to a person as "no
+// single client company" (audit/reconstruction.md §6.7, eval/iterations.md P5d).
+// Offline.  npx tsx test/v2SharedDomain.ts
+// ============================================================================
+import { plan, type World, type Message } from "../app/lib/v2/interpret/plan";
+import type { Interpretation, Request } from "../app/lib/v2/interpret/interpret";
+
+let fails = 0;
+const ok = (c: boolean, m: string, d = "") => { console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : `  ${d}`}`); if (!c) fails++; };
+
+const world = (companies: Array<{ id: number; name: string; Client: Array<{ id: number; email: string }> }>): World => ({
+  companies: async () => companies,
+  placesNamed: async (n) => (n.toLowerCase() === "tobacco dock" ? [{ id: 40, name: "Tobacco Dock" }] : []),
+  companyOrders: async () => [],
+  orderByNumber: async () => null,
+});
+const two = [
+  { id: 501, name: "Harbour Staging Ltd", Client: [{ id: 1, email: "ops@agency.example" }] },
+  { id: 635, name: "Lantern Events", Client: [{ id: 2, email: "bookings@agency.example" }] },
+];
+const msg = (from: string): Message => ({ message_id: "m1", from, subject: "Crew", sentIso: "2026-10-01T09:00:00Z", text: "Please book 4 crew at Tobacco Dock on 20 November, 08:00-16:00" });
+const booking = (company_name?: string): Interpretation => ({
+  intent: "booking", problems: [], ...(company_name ? { company_name } : {}),
+  requests: [{ action: "new_shift", problems: [], date: "2026-11-20", start: "08:00", end: "16:00", crew: 4, venue: "Tobacco Dock" } as Request],
+});
+const noClient = (d: any) => d.kind === "handoff" && /no single client company/.test((d.reasons ?? []).join());
+
+(async () => {
+  console.log("a domain two companies share");
+  ok(!noClient(await plan(msg("tom@agency.example"), booking("Lantern Events"), world(two))), "the company the email names, among the domain's, is the client");
+  ok(noClient(await plan(msg("tom@agency.example"), booking(), world(two))), "with no name written, it still goes to a person");
+  ok(noClient(await plan(msg("tom@agency.example"), booking("Some Other Co"), world(two))), "a name that matches neither goes to a person");
+  const both = [...two, { id: 777, name: "Lantern Harbour Hire", Client: [{ id: 3, email: "x@agency.example" }] }];
+  ok(noClient(await plan(msg("tom@agency.example"), booking("Lantern Harbour"), world(both))), "a name that matches two of them goes to a person");
+  console.log("a domain many companies share (a mail host)");
+  const many = [1, 2, 3, 4].map((n) => ({ id: 900 + n, name: `Client ${n} Lantern`, Client: [{ id: n, email: `p${n}@host.example` }] }));
+  ok(noClient(await plan(msg("tom@host.example"), booking("Lantern"), world(many))), "four or more companies on a domain are never chosen between by name");
+
+  // red-team-B H2 (10-26): icloud.com sits on exactly 2 of the 811 companies, and gmail.com on 34. A personal
+  // address says nothing about which company a person books for (resolve.ts CONSUMER_DOMAINS).
+  console.log("a personal mail host is no evidence of a company");
+  const icloud = [
+    { id: 501, name: "Harbour Staging Ltd", Client: [{ id: 1, email: "anna@icloud.com" }] },
+    { id: 635, name: "Lantern Events", Client: [{ id: 2, email: "ben@icloud.com" }] },
+  ];
+  const d1 = await plan(msg("new.person@icloud.com"), booking("Harbour Lights Weddings"), world(icloud));
+  ok(!(d1.kind === "write" && JSON.stringify(d1).includes("501")), "a new icloud.com sender is never given the company of another icloud.com contact", JSON.stringify(d1).slice(0, 200));
+  const gmail = [1, 2, 3, 4, 5, 6].map((n) => ({ id: 900 + n, name: `Gmail Client ${n}`, Client: [{ id: n, email: `p${n}@gmail.com` }] }));
+  const d2 = await plan(msg("new.person@gmail.com"), booking("Riverside Weddings"), world(gmail));
+  const d3 = await plan(msg("new.person@gmail.com"), booking("Riverside Weddings"), world([]));
+  ok(d3.kind === "write", "control: with no gmail.com company on file, the new client is created", JSON.stringify(d3).slice(0, 200));
+  ok(d2.kind === d3.kind, "gmail.com contacts on other companies do not stop a new client", JSON.stringify(d2).slice(0, 200));
+
+  if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+  console.log("\nall passed");
+})();
diff --git a/test/zonelessIsUtc.ts b/test/zonelessIsUtc.ts
new file mode 100644
index 0000000..79d455c
--- /dev/null
+++ b/test/zonelessIsUtc.ts
@@ -0,0 +1,39 @@
+// ============================================================================
+// An OnSinch time with no zone is UTC, whatever the machine's own zone is.
+// ----------------------------------------------------------------------------
+// OnSinch's audit rows write a slot's old and new times as "2026-10-23 07:30:00", UTC with no
+// zone. `new Date()` reads such a string in the process's zone, and the box the scoring scripts
+// run on is America/New_York: every staff re-time read 4 hours late, so every correct time
+// change was judged wrong (eval/diagnostic-11-3.md: 1 completed write instead of 7). Production
+// runs in UTC and never saw it, which is why only a non-UTC zone can prove the fix.
+// npx tsx test/zonelessIsUtc.ts
+// ============================================================================
+process.env.TZ = "America/New_York";
+
+let fails = 0;
+const ok = (c: boolean, m: string, d?: unknown) => { console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : "  " + JSON.stringify(d)}`); if (!c) fails++; };
+
+(async () => {
+  const { utcToLondon } = await import("../app/lib/v2/bot/ops");
+  const { truthKeys } = await import("../app/lib/v2/score");
+  ok(new Date("2026-10-23 07:30:00").getTimezoneOffset() !== 0, "the process is not on UTC, so the case below can fail");
+
+  console.log("\nan audit row's time, no zone");
+  ok(JSON.stringify(utcToLondon("2026-10-23 07:30:00")) === JSON.stringify({ date: "2026-10-23", time: "08:30" }), "07:30 UTC is 08:30 in London (BST)", utcToLondon("2026-10-23 07:30:00"));
+  ok(utcToLondon("2026-11-03T07:30:00").time === "07:30", "the T form too, in GMT", utcToLondon("2026-11-03T07:30:00"));
+  ok(utcToLondon("2026-10-23T23:30:00").date === "2026-10-24", "late UTC is the next London day", utcToLondon("2026-10-23T23:30:00"));
+
+  console.log("\na time that carries its zone is read as written");
+  ok(utcToLondon("2026-10-23T07:30:00+00:00").time === "08:30", "+00:00");
+  ok(utcToLondon("2026-10-23T07:30:00Z").time === "08:30", "Z");
+  ok(utcToLondon("2026-10-23T08:30:00+01:00").time === "08:30", "+01:00");
+
+  console.log("\nthe scorer judges a staff re-time at the hour it was booked");
+  const act = { at: "2026-10-20T10:00:00+00:00", by: 7, what: "edit", order_id: 1, number: "11000", company_id: 9, model: "Slot", model_id: 5,
+    changes: { beginning: { old: "2026-10-23 06:30:00", new: "2026-10-23 07:30:00" }, end: { old: "2026-10-23 14:30:00", new: "2026-10-23 15:30:00" } } };
+  const keys = truthKeys([act], () => ({ Job: [] })).keys;
+  ok(keys.includes("times 1/5=2026-10-23 08:30-16:30"), "08:30-16:30 London", keys);
+
+  if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+  console.log("\nall passed");
+})();
