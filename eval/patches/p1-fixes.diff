+// ============================================================================
+// Every "none" the planner gives has its own code, so the backlog counts it under its name.
+// ----------------------------------------------------------------------------
+// Two none reasons fell to "other" (10-25): the bare "already as asked" (7 of 799 read emails)
+// and "nothing new asked for: the requests are the thread's earlier ones" (6 of 400 in replay).
+// npx tsx test/v2ReasonCodes.ts
+// ============================================================================
+import { codeOfReason } from "../app/lib/v2/reasons";
+
+let fails = 0;
+const eq = (got: string, want: string, m: string) => { const c = got === want; console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : `  got ${got}`}`); if (!c) fails++; };
+eq(codeOfReason("already as asked"), "none_already_as_asked", "the bare already as asked");
+eq(codeOfReason("already as asked; PO \"see attached PO\" left off: not a single reference after a PO label"), "none_already_as_asked", "already as asked with a PO note");
+eq(codeOfReason("nothing new asked for: the requests are the thread's earlier ones"), "none_thread_history", "a repeat of the thread's earlier requests");
+eq(codeOfReason("no change asked for"), "none_nothing_to_do", "no change asked for is unchanged");
+eq(codeOfReason("the client accepted Spartan's quote: confirm the order in OnSinch"), "quote_accepted", "a quote acceptance");
+if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+console.log("\nall passed");
