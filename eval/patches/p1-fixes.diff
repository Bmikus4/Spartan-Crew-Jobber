+// ============================================================================
+// An earlier email of a burst is a card when the newest asks for nothing and it names a day and crew.
+// ----------------------------------------------------------------------------
+// Several new client emails are read as one and decided once, on the newest. When the newest is
+// "thanks" and its decision is `none`, the request in the earlier email went with it: 5 of dev's 21
+// silent misses (eval/iterations.md, iteration 4). The reader had both texts joined and still read
+// nothing, so the earlier email's own words decide whether a person should read it.
+// npx tsx test/v2BurstUnread.ts
+// ============================================================================
+import { settleEarlier, BURST_UNREAD } from "../app/lib/v2/process";
+
+let fails = 0;
+const ok = (c: boolean, m: string, d?: unknown) => { console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : "  " + JSON.stringify(d)}`); if (!c) fails++; };
+const SENT = "2026-10-08T13:59:56Z";
+const booking = "Hi, could we get 4 crew on Friday 17th October, 08:00 to 16:00 please?";
+const later = { message_id: "later-1" };
+
+const a = settleEarlier(booking, SENT, { ...later, decision: { kind: "none", reason: "no change asked for" } });
+ok(a.kind === "handoff" && a.reasons[0].includes(BURST_UNREAD), "a booking before a 'thanks' that was decided none is a card", a);
+ok(a.code === "reading_burst_unread", "with its own code, not none_read_together", a.code);
+const b = settleEarlier("Thanks, see you then!", SENT, { ...later, decision: { kind: "none", reason: "no change asked for" } });
+ok(b.kind === "none" && b.code === "none_read_together", "an earlier 'thanks' stays read together", b);
+const c = settleEarlier(booking, SENT, { ...later, decision: { kind: "write", ops: [], why: [] } });
+ok(c.kind === "none" && c.code === "none_read_together", "when the newest was acted on, the earlier one is settled by it", c);
+const d = settleEarlier(booking, SENT, { ...later, decision: { kind: "handoff", reasons: ["x"] } });
+ok(d.kind === "none", "when the newest is a card, the earlier one is on it", d);
+const f = settleEarlier(booking, SENT, { ...later, decision: { kind: "none", reason: "R10522 shift 35071: times to 17:00-22:00", found: [16614] } });
+ok(f.kind === "handoff" && f.order_id === 16614, "the order the newest was checked against goes on the card", f);
+const e = settleEarlier("Please can you confirm the venue address for the 17th?", SENT, { ...later, decision: { kind: "none", reason: "no change asked for" } });
+ok(e.kind === "none", "a day with no crew count and no time is not enough", e);
+
+if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+console.log("\nall passed");
