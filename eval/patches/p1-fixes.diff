+// ============================================================================
+// A client accepting Spartan's quote is a card about the quote's order, never "Order Needs Created".
+// ----------------------------------------------------------------------------
+// OnSinch already holds the quote as an order for 54 of 73 acceptances (eval/acceptance-study.md).
+// A reading of new shifts with no order named drew the card as Needs Created, and the thread's Gmail
+// label followed it: 4 of the 39 dev acceptance cards told staff to build an order that existed
+// (red-team-B H4, 10-26). A plain new booking with no order is still Needs Created.
+// npx tsx test/feedQuoteAcceptedIsUpdate.ts
+// ============================================================================
+import { project } from "../app/lib/feed/project";
+import { v2Sources, type V2Row } from "../app/lib/feed/v2";
+import { QUOTE_ACCEPTED } from "../app/lib/v2/acceptance";
+
+let fails = 0;
+const ok = (c: boolean, m: string, d?: unknown) => { console.log(`  ${c ? "PASS" : "FAIL"}  ${m}${c ? "" : "  " + JSON.stringify(d)}`); if (!c) fails++; };
+
+const NOW = Date.parse("2026-10-03T12:00:00Z");
+const shifts = { intent: "booking", requests: [{ action: "new_shift", date: "2026-10-14", start: "08:00", end: "16:00", crew: 4, problems: [] }], problems: [] };
+const row = (thread: string, over: Partial<V2Row>): V2Row => ({
+  thread_id: thread, message_id: `${thread}-m`, sent_at: new Date(NOW - 3 * 3_600_000).toISOString(), kind: "handoff",
+  grounded: shifts as any, decision: { kind: "handoff", reasons: ["x"] }, executed: null, company_id: 343, company: "Client",
+  from_address: "sam@client.example", subject: "Crew", ...over,
+});
+const accepted = row("A", { decision: { kind: "handoff", reasons: [QUOTE_ACCEPTED] } });
+const known = row("K", { decision: { kind: "handoff", reasons: [QUOTE_ACCEPTED], order_id: 16614 } });
+const fresh = row("N", { decision: { kind: "handoff", reasons: ["2026-10-14 is within 7 days of the email: a person creates it"] } });
+// An email with no reading of its own (read with a later one, iteration 4) whose decision names its order.
+const unreadKnown = row("U", { grounded: null as any, decision: { kind: "handoff", reasons: ["the later email x asks for nothing, and this earlier email names a day and crew or a time: a person reads it"], order_id: 13597 } });
+const unreadNone = row("V", { grounded: null as any, decision: { kind: "handoff", reasons: ["the later email x asks for nothing, and this earlier email names a day and crew or a time: a person reads it"] } });
+const cards = project([], new Map(), [], null, NOW, new Map(), v2Sources([accepted, known, fresh, unreadKnown, unreadNone], NOW)).cards;
+const kindOf = (t: string) => cards.find((c) => c.thread_id === t)?.items[0]?.kind;
+
+ok(kindOf("A") === "needs-updated", "an acceptance whose order the planner did not single out is an update", kindOf("A"));
+ok(kindOf("K") === "needs-updated", "an acceptance with its order is an update", kindOf("K"));
+ok(kindOf("N") === "needs-created", "a new booking with no order is still Needs Created", kindOf("N"));
+ok(kindOf("U") === "needs-updated", "an email with no reading whose decision names its order is an update", kindOf("U"));
+ok(kindOf("V") === "needs-created", "an email with no reading and no order stays Needs Created", kindOf("V"));
+
+if (fails) { console.log(`\n${fails} FAILED`); process.exit(1); }
+console.log("\nall passed");
